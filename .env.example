# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are exposed to the browser. Keep secrets un-prefixed.

# Public URL of the app (used for metadata and, later, shareable invoice links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API. Optional until auth/saving is built.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets go below when needed (e.g. SUPABASE_SECRET_KEY, email provider key).

# Email invoices (Phase 16): Resend (https://resend.com/api-keys). Required to
# actually send; the compose UI works without it and says what's missing.
RESEND_API_KEY=
# Verified sender, e.g. "Your Studio <invoices@yourdomain.com>". Until a domain
# is verified, leave empty to use Resend's sandbox sender (test mode only).
EMAIL_FROM=
